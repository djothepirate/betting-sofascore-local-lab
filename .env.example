# Copy to .env through scripts/Initialize-LocalConfig.ps1.
# Never commit the generated .env file.
POSTGRES_DB=sofascore_local_lab
POSTGRES_USER=sofascore_lab
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
POSTGRES_PORT=5432

# J3 provider qualification stays disabled in a freshly initialized environment.
SOFASCORE_ENABLED=false
SOFASCORE_J3_QUALIFICATION_ENABLED=false
SOFASCORE_BASE_URL=
SOFASCORE_ALLOWED_ENDPOINTS=
