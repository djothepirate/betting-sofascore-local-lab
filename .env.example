# Copy to .env through scripts/Initialize-LocalConfig.ps1.
# Never commit the generated .env file.
POSTGRES_DB=sofascore_local_lab
POSTGRES_USER=sofascore_lab
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD
POSTGRES_PORT=5432

# Every provider qualification path stays disabled in a freshly initialized environment.
SOFASCORE_ENABLED=false
SOFASCORE_J3_QUALIFICATION_ENABLED=false
SOFASCORE_J4_EVENT_DETAILS_QUALIFICATION_ENABLED=false
SOFASCORE_J4_EVENT_DETAILS_PHASE2_ENABLED=false
SOFASCORE_J5_EVENT_DATA_QUALIFICATION_ENABLED=false
SOFASCORE_TOURNAMENT_EVENT_DISCOVERY_ENABLED=false
SOFASCORE_BASE_URL=
SOFASCORE_ALLOWED_ENDPOINTS=

# WO-060: the daily preference is initially enabled in PostgreSQL; the GUI persists later choices.
# Only a qualified local web application schedules; maintenance CLIs never schedule.
# This technical switch also disables manual admission. Use the GUI to disable only automation.
SOFASCORE_J3_RUNTIME_ENABLED=true

# Playwright stays disabled in this fresh J0/J1 configuration. A qualified J3 web launcher
# can open its local worker automatically under the durable WO-060 preference.
SOFASCORE_PLAYWRIGHT_ENABLED=false
SOFASCORE_PLAYWRIGHT_WORKER_JAR=
SOFASCORE_PLAYWRIGHT_MAXIMUM_HEAP_MIB=192
SOFASCORE_PLAYWRIGHT_STARTUP_TIMEOUT=30s
SOFASCORE_PLAYWRIGHT_REQUEST_TIMEOUT=10s
SOFASCORE_PLAYWRIGHT_GRACEFUL_CLOSE_TIMEOUT=5s
SOFASCORE_PLAYWRIGHT_LOOPBACK_QUALIFICATION=false
SOFASCORE_PLAYWRIGHT_LOOPBACK_ORIGIN=

# New live preparations require the independent V11 profile (no fallback from V10).
# Display its ten launcher entries with scripts/Show-LiveGroupedV11LauncherConfiguration.ps1.
# This example does not enable live or install a qualification profile.
