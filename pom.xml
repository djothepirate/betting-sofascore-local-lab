<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>com.bettingproject</groupId>
  <artifactId>betting-sofascore-local-lab</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>SofaScore Local Lab</name>
  <description>Laboratoire local et contrôlé d'enrichissement SofaScore pour le Betting Project</description>
  <url>https://github.com/djothepirate/betting-sofascore-local-lab</url>
  <licenses>
    <license>
      <name>Proprietary</name>
      <comments>All rights reserved. No license or other rights are granted except under a separate written agreement.</comments>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/djothepirate/betting-sofascore-local-lab.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/djothepirate/betting-sofascore-local-lab.git</developerConnection>
    <url>https://github.com/djothepirate/betting-sofascore-local-lab</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <java.version>25</java.version>
    <maven.minimum.version>3.9.0</maven.minimum.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <json-schema-validator.version>3.0.6</json-schema-validator.version>
    <playwright.version>1.62.0</playwright.version>
    <spring-boot.run.main-class>com.bettingproject.sofascorelocal.SofascoreLocalApplication</spring-boot.run.main-class>
    <main.output.directory>${project.build.directory}/classes</main.output.directory>
    <test.output.directory>${project.build.directory}/test-classes</test.output.directory>
    <j7.no-automatic-retry.jvm-arguments>-Djdk.httpclient.disableRetryConnect=true -Djdk.httpclient.redirects.retrylimit=1 -Djdk.httpclient.enableAllMethodRetry=false</j7.no-automatic-retry.jvm-arguments>
    <jacoco.agent.argLine></jacoco.agent.argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <exclusions>
        <exclusion>
          <groupId>tools.jackson.dataformat</groupId>
          <artifactId>jackson-dataformat-yaml</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <outputDirectory>${main.output.directory}</outputDirectory>
    <testOutputDirectory>${test.output.directory}</testOutputDirectory>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>fixtures</directory>
        <targetPath>fixtures</targetPath>
        <filtering>false</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>${spring-boot.run.main-class}</mainClass>
          <jvmArguments>${j7.no-automatic-retry.jvm-arguments}</jvmArguments>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${j7.no-automatic-retry.jvm-arguments} @{jacoco.agent.argLine}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>${j7.no-automatic-retry.jvm-arguments} @{jacoco.agent.argLine}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[${maven.minimum.version},4.0.0)</version>
                  <message>Apache Maven 3.9.x est requis. Utiliser mvnw ou mvnw.cmd.</message>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[25,26)</version>
                  <message>Java 25 LTS est requis pour compiler et exécuter le laboratoire.</message>
                </requireJavaVersion>
                <requireProperty>
                  <property>project.groupId</property>
                  <regex>^com\.bettingproject$</regex>
                  <message>Le groupId Maven doit rester com.bettingproject.</message>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>integration-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <argLine>${j7.no-automatic-retry.jvm-arguments} @{jacoco.agent.argLine}</argLine>
                  <includes>
                    <include>**/integration/**/*IT.java</include>
                  </includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>provider-playwright-runtime</id>
      <properties>
        <main.output.directory>${project.build.directory}/provider-playwright-runtime/classes</main.output.directory>
        <test.output.directory>${project.build.directory}/provider-playwright-runtime/test-classes</test.output.directory>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.microsoft.playwright</groupId>
          <artifactId>playwright</artifactId>
          <version>${playwright.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-provider-playwright-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/provider-playwright/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-provider-playwright-test-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/provider-playwright-test/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>package-provider-playwright-worker</id>
                <phase>package</phase>
                <goals>
                  <goal>repackage</goal>
                </goals>
                <configuration>
                  <classifier>provider-playwright-worker</classifier>
                  <mainClass>com.bettingproject.sofascorelocal.provider.playwright.worker.ProviderPlaywrightWorkerMain</mainClass>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>provider-playwright-local-qualification</id>
      <properties>
        <test.output.directory>${project.build.directory}/provider-playwright-runtime/test-classes</test.output.directory>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-provider-playwright-qualification-test-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/provider-playwright-qualification-test/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>provider-playwright-loopback-qualification</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
                <configuration>
                  <includes>
                    <include>**/*LocalQualificationIT.java</include>
                  </includes>
                  <systemPropertyVariables>
                    <provider.playwright.worker-jar>${project.build.directory}/${project.build.finalName}-provider-playwright-worker.jar</provider.playwright.worker-jar>
                    <provider.playwright.browser-cache>${provider.playwright.browser-cache}</provider.playwright.browser-cache>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>sofascore-live-test</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>block-live-tests-before-j3</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <alwaysFail>
                      <message>Le profil sofascore-live-test est volontairement bloqué au jalon J1. Aucun appel réel n'est implémenté avant le jalon J3 et un Work Order dédié.</message>
                    </alwaysFail>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
